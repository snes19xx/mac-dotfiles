              { "type": "basic", "from": { "key_code": "x", "modifiers": { "mandatory": ["control"] } }, "to": [{ "key_code": "c", "modifiers": ["left_command"] }, { "set_variable": { "name": "finder_cut", "value": 1 } }], "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.apple\\.finder$"] }] },
