              { "type": "basic", "from": { "key_code": "v", "modifiers": { "mandatory": ["control"] } }, "to": [{ "key_code": "v", "modifiers": ["left_command", "left_option"] }, { "set_variable": { "name": "finder_cut", "value": 0 } }], "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.apple\\.finder$"] }, { "type": "variable_if", "name": "finder_cut", "value": 1 }] },
              { "type": "basic", "from": { "key_code": "f2" }, "to": [{ "key_code": "return_or_enter" }], "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.apple\\.finder$"] }] },
